; Copiar a ia.ini (no va al repositorio: lleva el token).
[deltha]
url   = https://deltha.eu
; el mismo valor que [ia] token (o, si no existe, [mod] token) en /etc/deltha/config.ini del droplet
token =

[modelo]
; el mismo modelo que arranca local/moderador/arrancar-modelo.ps1 (Strata o llama-server); una peticion cada vez
url     = http://127.0.0.1:8080
api_key =
timeout = 180
; nombre que se guarda con cada resultado (ia_jobs.model / mod_queue.model)
nombre  = Qwen3.8-Flash-Next-IQ2_XS

[worker]
; trabajos que pide en cada pasada: de uno en uno, para que lo urgente (Sigfrid, con una persona esperando en el Chat)
; no aguarde detras de un lote. El worker solo descansa con la cola vacia, asi que no pierde ritmo
lote         = 1
; sondeo largo: segundos que Deltha retiene la peticion con la cola vacia; la suelta en cuanto entra un trabajo (0 = no; tope 25)
sondeo       = 20
; segundos de espera con la cola vacia si no hay sondeo largo, y tras un error
espera       = 5
espera_error = 60
