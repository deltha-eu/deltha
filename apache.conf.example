# /etc/apache2/sites-available/deltha.conf
# Delta de Dirac — vhost de pruebas (Apache 2.4 + PHP-FPM)
#
# Ajustar: ServerName, DocumentRoot y la versión de php-fpm en SetHandler.
#
# Módulos necesarios (comprobar con apachectl -M):
#   a2enmod rewrite headers expires proxy_fcgi setenvif
#   a2enconf php8.3-fpm            # o la versión que tengas (ls /run/php/)
# Activar:
#   a2ensite deltha && apachectl configtest && systemctl reload apache2
#   certbot --apache -d deltha.eu -d www.deltha.eu
#
# OJO: este fichero solo trae el vhost :80. En el droplet, deltha.conf lleva ademas un
# <VirtualHost *:443> identico con el certificado de origen de Cloudflare (lo genera
# install-droplet.sh). NO copiar este fichero encima del deltha.conf del servidor: sin el
# vhost 443 Cloudflare (Completo estricto) da error 525. Para actualizarlo sin perder el 443:
#   scp apache.conf.example root@deltha.eu:/root/ && ssh root@deltha.eu bash /var/www/deltha/scripts/vhost-actualizar.sh

<VirtualHost *:80>
    ServerName deltha.eu
    ServerAlias www.deltha.eu

    DocumentRoot /var/www/deltha/public

    ErrorLog  ${APACHE_LOG_DIR}/deltha.error.log
    CustomLog ${APACHE_LOG_DIR}/deltha.access.log combined

    # PHP via FPM (si el servidor usa mod_php en vez de FPM, borra este bloque: PHP ya funciona)
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.3-fpm.sock|fcgi://localhost"
    </FilesMatch>

    <Directory /var/www/deltha/public>
        Options -Indexes -MultiViews +FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
    </Directory>

    # --- cabeceras: sin rastreo, sin terceros; el único JS es /app/register.js (service worker de la PWA).
    #     style-src lleva 'unsafe-inline' porque fotos, velos y halos de aura se pintan con style= en línea ---
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "interest-cohort=(), browsing-topics=(), geolocation=(), camera=(), microphone=()"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"

    # --- estáticos: caché larga ---
    <Directory /var/www/deltha/public/media>
        ExpiresActive On
        ExpiresDefault "access plus 30 days"
        Header set Cache-Control "public, immutable"
        # nunca ejecutar nada subido
        <FilesMatch "\.(php|phtml|phar)$">
            Require all denied
        </FilesMatch>
    </Directory>
    # --- PWA (/app): el service worker vive en /app/ pero controla todo el sitio ---
    <Files "sw.js">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache"
    </Files>
    <Files "manifest.webmanifest">
        ForceType application/manifest+json
    </Files>
    # el manifiesto es dinamico (iconos de Admin > Logo): sin cache, o el movil tarda 7 dias en ver el icono nuevo
    <Files "manifest.php">
        ExpiresActive Off
        Header set Cache-Control "no-cache"
    </Files>
    <DirectoryMatch "^/var/www/deltha/public/(css|img|app)">
        ExpiresActive On
        ExpiresDefault "access plus 7 days"
        Header set Cache-Control "public"
    </DirectoryMatch>

    # --- nada del repo servible por accidente ---
    <FilesMatch "\.(ini|sql|sh|md|example)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    # subida de fotos (img_max_bytes = 6 MB)
    LimitRequestBody 8388608

    # robots: lo sirve PHP a partir de public/robots.txt (config robots_ai_users deja pasar a los asistentes de IA a peticion)
    AliasMatch ^/robots\.txt$ /var/www/deltha/public/robots.php
    # /favicon.ico (lo piden Windows, lectores y clientes viejos sin mirar el <link rel="icon">): el icono en vigor, servido por PHP
    AliasMatch ^/favicon\.ico$ /var/www/deltha/public/favicon.php
</VirtualHost>
